# Telegram API Credentials
# Получить на https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Номер телефона (с кодом страны)
TELEGRAM_PHONE=+79001234567

# Имя файла сессии (будет создан автоматически)
SESSION_NAME=telegram_parser_session

# Целевой чат для парсинга
# Варианты:
# - Username: @channel_username
# - ID: -1001234567890 (для каналов/групп с -100 префиксом)
# - Ссылка: https://t.me/channel_username
TARGET_CHAT=@example_channel

# Лимит сообщений (оставьте пустым для парсинга всех сообщений)
MESSAGE_LIMIT=1000

# Директория для сохранения результатов
OUTPUT_DIR=./output

# Скачивать медиа файлы (true/false)
DOWNLOAD_MEDIA=false
